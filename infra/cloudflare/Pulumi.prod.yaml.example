config:
  # Fill via bin/setup-cloudflare-hosting.sh (writes gitignored Pulumi.<stack>.yaml).
  steerlens:accountId: YOUR_CLOUDFLARE_ACCOUNT_ID
  steerlens:zoneId: YOUR_CLOUDFLARE_ZONE_ID
  steerlens:pagesProjectName: steerlens
  # Subdomain on the shared mzworthington.co.uk zone (owned by edge-dns):
  steerlens:pagesHostnames:
    - steerlens.mzworthington.co.uk
