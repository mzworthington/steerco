config:
  # Fill via bin/setup-cloudflare-hosting.sh (writes gitignored Pulumi.<stack>.yaml).
  steerco:accountId: YOUR_CLOUDFLARE_ACCOUNT_ID
  steerco:zoneId: YOUR_CLOUDFLARE_ZONE_ID
  steerco:pagesProjectName: steerco
  # Subdomain on the shared mzworthington.co.uk zone (owned by edge-dns):
  steerco:pagesHostnames:
    - steerco.mzworthington.co.uk
  # Optional: former hostnames that 301 to the first pagesHostname
  steerco:legacyRedirectHostnames:
    - steerlens.mzworthington.co.uk
