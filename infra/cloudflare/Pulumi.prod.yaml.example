config:
  # Fill via bin/setup-cloudflare-hosting.sh (writes gitignored Pulumi.<stack>.yaml).
  # Do not commit real account/zone/hostnames in the template.
  react-cloudflare-template:accountId: YOUR_CLOUDFLARE_ACCOUNT_ID
  react-cloudflare-template:zoneId: YOUR_CLOUDFLARE_ZONE_ID
  react-cloudflare-template:pagesProjectName: my-app
  # Subdomains on an existing active zone:
  react-cloudflare-template:pagesHostnames:
    - app.example.com
