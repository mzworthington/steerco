#!/usr/bin/env sh
STAGED=$(git diff --cached --name-only)

NEEDS_CHECKS=false
if echo "$STAGED" | grep -qE '^(app/|docs/)'; then
  NEEDS_CHECKS=true
fi
if echo "$STAGED" | grep -qE '\.(md|ts|tsx|css|json)$'; then
  NEEDS_CHECKS=true
fi

if [ "$NEEDS_CHECKS" = true ]; then
  echo "Running pre-commit checks..."
  cd app
  pnpm exec lint-staged
  pnpm run format:check
  pnpm run lint
  pnpm run typecheck
  cd ..
fi
