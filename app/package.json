{
  "name": "@steerco/app",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "prepare": "cd .. && husky",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/verifyPwaBuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false && pnpm --filter @steerco/core typecheck",
    "lint": "oxlint src packages/core/src",
    "format": "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write \"**/*.{ts,tsx,css,json,md,html,yml,yaml}\" \"../*.md\" \"../docs/**/*.{md,ts}\" \"../.github/**/*.{yml,yaml,md}\"",
    "format:check": "prettier --config ../.prettierrc --ignore-path ../.prettierignore --check \"**/*.{ts,tsx,css,json,md,html,yml,yaml}\" \"../*.md\" \"../docs/**/*.{md,ts}\" \"../.github/**/*.{yml,yaml,md}\"",
    "test": "vitest run && pnpm --filter @steerco/core test",
    "test:coverage": "vitest run --coverage && pnpm --filter @steerco/core exec vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa": "node scripts/verifyPwaBuild.mjs",
    "test:lighthouse": "lhci autorun",
    "lighthouse:summary": "node scripts/writeLighthouseSummary.mjs",
    "record:docs-media": "RECORD_DOCS_MEDIA=1 playwright test --config playwright.docs-media.config.ts",
    "sync-derived": "../bin/sync-derived.sh",
    "knip": "knip"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@steerco/core": "workspace:*",
    "@xyflow/react": "12.12.1",
    "mermaid": "^12.3.0",
    "posthog-js": "^1.447.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "fake-indexeddb": "6.2.8",
    "git-cliff": "2.14.2",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "knip": "6.45.1",
    "lint-staged": "17.6.0",
    "oxlint": "1.93.0",
    "playwright": "1.65.0",
    "prettier": "3.10.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "wrangler": "4.160.1"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css,html}": [
      "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write"
    ],
    "../docs/**/*.{md,ts}": [
      "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write"
    ],
    "../*.md": [
      "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write"
    ],
    "../.github/**/*.{yml,yaml,md}": [
      "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write"
    ]
  }
}
