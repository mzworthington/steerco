{
  "name": "@steerco/app",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "prepare": "cd .. && husky",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/verifyPwaBuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false && pnpm --filter @steerco/core typecheck",
    "lint": "oxlint src packages/core/src",
    "format": "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write \"**/*.{ts,tsx,css,json,md,html,yml,yaml}\" \"../*.md\" \"../docs/**/*.{md,ts}\" \"../.github/**/*.{yml,yaml,md}\"",
    "format:check": "prettier --config ../.prettierrc --ignore-path ../.prettierignore --check \"**/*.{ts,tsx,css,json,md,html,yml,yaml}\" \"../*.md\" \"../docs/**/*.{md,ts}\" \"../.github/**/*.{yml,yaml,md}\"",
    "test": "vitest run && pnpm --filter @steerco/core test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa": "node scripts/verifyPwaBuild.mjs",
    "test:lighthouse": "lhci autorun",
    "lighthouse:summary": "node scripts/writeLighthouseSummary.mjs",
    "record:docs-media": "RECORD_DOCS_MEDIA=1 playwright test --config playwright.docs-media.config.ts",
    "sync-derived": "../bin/sync-derived.sh",
    "knip": "knip"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@posthog/react": "^1.10.5",
    "@steerco/core": "workspace:*",
    "@xyflow/react": "12.11.5",
    "mermaid": "11.16.1",
    "posthog-js": "^1.425.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "wouter": "3.10.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "fake-indexeddb": "6.2.5",
    "git-cliff": "2.13.1",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "knip": "6.32.0",
    "lint-staged": "17.3.0",
    "oxlint": "1.77.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "wrangler": "4.120.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css,html}": [
      "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write"
    ],
    "../docs/**/*.{md,ts}": [
      "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write"
    ],
    "../*.md": [
      "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write"
    ]
  }
}
