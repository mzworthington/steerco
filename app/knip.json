{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "workspaces": {
    ".": {
      "entry": ["../bin/changelog-render.mjs", "lighthouserc.cjs"],
      "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.mjs", "../bin/**/*.mjs"],
      "ignoreDependencies": ["wrangler", "git-cliff", "lint-staged", "prettier-plugin-tailwindcss"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"]
    }
  }
}
