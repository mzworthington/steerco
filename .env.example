# Local hosting bootstrap: optional `.env` for `bin/setup-cloudflare-hosting.sh`.
# Prefer Bitwarden (BWS_*) + shell exports. Canonical script lives in edge-dns;
# this repo keeps a thin shim. Never commit `.env`.
# CI uses GitHub Actions secrets/vars instead.

PULUMI_STACK=prod

# Zone for mzworthington.co.uk is owned by edge-dns; this product owns the
# Pages project + steerlens.mzworthington.co.uk custom domain.
DOMAIN=mzworthington.co.uk

# Comma-separated subdomain hostnames to attach to the Pages project
PAGES_HOSTNAMES=steerlens.mzworthington.co.uk

# Pages project name (also used for *.pages.dev)
PAGES_PROJECT_NAME=steerlens

# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# PULUMI_ACCESS_TOKEN=
# BWS_ACCESS_TOKEN=
# BWS_PROJECT_ID=
